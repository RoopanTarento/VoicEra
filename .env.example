# Mongo-compatible DB via FerretDB (PostgreSQL + DocumentDB under the hood).
# In Docker Compose use MONGODB_HOST=mongodb (network alias for ferretdb).
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=voicera
MONGODB_AUTH_SOURCE=

# Application
DEBUG=False
PROJECT_NAME=Voicera API
VERSION=0.1.0

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=Fn_VXROYOWm4_3l9BwNhZt2bcGezdHS8DIsnu8at_fc
INTERNAL_API_KEY=7kgsAkJGW48ddKTgDrpQPbMIP8gnJTqVzyKRJDQ5_Kg

# Password-reset email (Mailtrap)
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=noreply@voicera.com
MAILTRAP_FROM_NAME=Voicera
FRONTEND_URL=http://localhost:3000
FERRETDB_HOST_PORT=27018
API_HOST_PORT=8000
RUNTIME_HOST_PORT=7860
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_AUTH_ENCRYPTION_KEY=4t5NMi97Y9DhB_Vc12Vn8q6SDdUhDTR4GeaJyLm_E1w=
VOICE_SERVER_BASE_URL=https://vobiz.johnaic.com

# --- Runtime (apps/runtime) ---
API_BASE_URL=http://localhost:8000/api/v1
SAMPLE_RATE=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=voicera-calls
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# Knowledge base (Chroma + embeddings; API only)
CHROMA_BASE_DIR=app/rag/chroma_data
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=text-embedding-3-small

# VoicERA Copilot (apps/api/app/services/copilot). Provider is any
# OpenAI-compatible chat-completions API already in the provider registry:
# openai, groq (free tier), or openrouter. Model defaults to that provider's
# own catalog default when left blank. This key is only a platform-wide
# fallback — an org's own credential added under Integrations takes priority.
COPILOT_LLM_PROVIDER=openai
COPILOT_LLM_MODEL=
COPILOT_LLM_API_KEY=
# Files attached in the Agent Builder chat. Images go to a vision model on the
# same provider when the chat model can't see them (blank = a default per
# provider). Documents (PDF, Word, PowerPoint, Excel, text) are sent as text,
# cut to this many characters per turn; raise it if your provider allows more
# tokens per minute than Groq's free tier.
COPILOT_VISION_MODEL=

# Platform default providers: new workspaces can build and call agents on keys this
# workspace stored under Integrations, until they connect their own. Only the API
# and the voice runtime ever read these keys; workspace users never see them.
# AI providers only (telephony is never lent). Blank DEFAULT_PROVIDERS_ORG_ID = off.
DEFAULT_PROVIDERS_ORG_ID=
DEFAULT_PROVIDERS=openai

# No-login demo builder (/ and /try): visitors build an agent from the demo knowledge base and test-call it.
# Uses TRY_LLM_API_KEY, else TRY_KEY_ORG_ID's Integrations key, else KB_EMBEDDING_API_KEY (OpenAI).
TRY_ENABLED=true
TRY_LLM_PROVIDER=openai
TRY_LLM_MODEL=gpt-4.1
TRY_LLM_API_KEY=
TRY_KEY_ORG_ID=
# Demo limits: 0 = no limit (the default). Set a number to cap use of the public page.
TRY_TURNS_PER_IP_HOUR=0
TRY_TURNS_PER_DAY=0
# Browser test calls on the /try page: short-lived agents in a hidden preview workspace,
# on the first available provider in each list (keys come from DEFAULT_PROVIDERS above,
# or the model server for self-hosted ones). The browser ends a call after TRY_CALL_MAX_SECONDS.
TRY_CALLS_PER_IP_HOUR=0
TRY_CALLS_PER_DAY=0
TRY_CALL_MAX_SECONDS=180
TRY_AGENT_TTL_MINUTES=30
# IndicConformer (the demo spec's listener) has no English: Indic-Transcribe or Indic Nemotron take it.
TRY_STT_PROVIDERS=indic_conformer,indic_transcribe,indic_nemotron,sarvam,google,openai
TRY_TTS_PROVIDERS=maya2_native,indic_orpheus,sarvam,google,openai
# Proxies that append X-Forwarded-For before the API (Next.js = 1; add 1 each for a Cloudflare tunnel, nginx or load balancer).
# Too low and every visitor shares one IP, so the per-IP limits above run out for everyone at once.
TRY_TRUSTED_PROXY_HOPS=1
# Demo knowledge base: which 'state' values load (the workbook is written for Karnataka).
# Publish a new workbook with: docker compose exec api python -m app.services.demo.kb publish /path/to/file.xlsx
DEMO_KB_STATES=National,KA,State,District
COPILOT_DOCUMENT_CONTEXT_CHARS=6000

# Redis (ARQ job queue + campaign pub/sub)
REDIS_PASSWORD=redissecret
REDIS_URL=redis://:redissecret@localhost:6379
CAMPAIGN_BATCH_SIZE=10
DEFAULT_ORG_CONCURRENCY_LIMIT=10

# Comma-separated hostnames allowed as Next.js allowedDevOrigins (no scheme).
ALLOWED_DEV_ORIGINS=voicera.johnaic.com

# Browser test-call WebSocket is proxied same-origin (/agent/* → runtime:7860).
# Only port 3000 needs to be public — no separate runtime URL or ngrok on 7860.


# --- VoicEra Secure (contact vault) --------------------------------------
# Versioned AES-256 keys, "v1:<key>,v2:<key>". Generate each key with:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Never reuse the example values below; the security health check flags them.
SECURE_VAULT_KEYS=v1:REPLACE_WITH_GENERATED_KEY
SECURE_VAULT_ACTIVE_KEY_VERSION=v1
# Optional: hash keys are now generated per adopter and wrapped by the master
# key above. Leave empty unless upgrading an older single-key deployment.
SECURE_VAULT_INDEX_KEY=
# VoicEra platform admins (manage adopters; no access to adopter data).
PLATFORM_ADMIN_EMAILS=
# External services allowed to resolve contact IDs: "service_id|scope+scope|secret"
# (scopes: contacts:resolve:dial, contacts:resolve). Leave empty if none.
SECURE_SERVICE_CREDENTIALS=
SECURE_DEFAULT_REGION=IN
SECURE_RESOLVE_RATE_LIMIT_PER_MINUTE=600
SECURE_DENIAL_ALERT_THRESHOLD=5
SECURE_CONTACT_RETENTION_DAYS=365
SECURE_ENFORCE_VAULT_CAMPAIGNS=false
# Mock telephony provider for local demos only. Keep false in production.
TELEPHONY_MOCK_ENABLED=false
